---
/**
 * Schmaler Hinweis-Balken für das nächste angepinnte Event.
 *
 * Sitzt bewusst ÜBER dem Header: Die erste Hero-Sektion zieht sich per
 * `margin-top: -10rem` unter den Filmstreifen (siehe global.css). Läge der
 * Balken zwischen Header und Hero, würde er diese Verzahnung — und damit die
 * eingemessene Kronleuchter-Position — zerstören. Über dem Header wandert
 * einfach alles gemeinsam nach unten, das Zusammenspiel bleibt unangetastet.
 *
 * Gibt es kein angepinntes Event, wird gar nichts ausgegeben.
 */
import {getHinweisEvent, type Event} from "../lib/sanity"

const event = await getHinweisEvent()

function kurzDatum(e: Event): string | null {
  if (e.wiederkehrend) return e.wiederkehrend
  if (!e.startDatum) return null
  const opt: Intl.DateTimeFormatOptions = {day: "2-digit", month: "2-digit", year: "numeric"}
  const start = new Date(e.startDatum).toLocaleDateString("de-DE", opt)
  if (!e.endDatum || e.endDatum === e.startDatum) return start
  return `${start} – ${new Date(e.endDatum).toLocaleDateString("de-DE", opt)}`
}

const text = event?.pinnHinweis?.trim() || event?.titel || ""
const datum = event ? kurzDatum(event) : null
const ziel = event ? `/events/${event.slug.current}` : "/events"
---

{event && (
  <aside
    id="event-hinweis"
    data-event-id={event._id}
    aria-label="Aktueller Hinweis"
    class="relative z-40 border-b border-vintage-gold/25 text-creme"
    style="background: #241A15;"
  >
    <div class="max-w-7xl mx-auto px-4 py-2.5 flex items-center gap-3 text-sm">
      <span
        aria-hidden="true"
        class="hidden sm:inline-block shrink-0 w-1.5 h-1.5 rotate-45"
        style="background: #C9A55C;"
      ></span>

      <a
        href={ziel}
        class="flex-1 min-w-0 flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 group"
      >
        {datum && (
          <span class="shrink-0 text-xs uppercase tracking-[0.18em]" style="color: #C9A55C;">
            {datum}
          </span>
        )}
        <span class="truncate-2 text-creme/90 group-hover:text-creme transition-colors">
          {text}
        </span>
        <span
          class="shrink-0 text-xs border-b border-vintage-gold/50 group-hover:border-vintage-gold transition-colors"
          style="color: #C9A55C;"
        >
          Mehr erfahren <span aria-hidden="true">→</span>
        </span>
      </a>

      <button
        type="button"
        id="event-hinweis-schliessen"
        aria-label="Hinweis ausblenden"
        class="shrink-0 w-11 h-11 -m-2 grid place-items-center rounded text-creme/60 hover:text-creme hover:bg-creme/10 transition-colors"
      >
        <span aria-hidden="true" class="text-lg leading-none">×</span>
      </button>
    </div>
  </aside>

  <script is:inline>
    // Direkt nach dem Balken ausgeführt, damit ein bereits weggeklickter
    // Hinweis nicht kurz aufblitzt. Ohne JavaScript bleibt der Balken
    // sichtbar — das ist die richtige Voreinstellung.
    (function () {
      var balken = document.getElementById("event-hinweis")
      if (!balken) return
      var SCHLUESSEL = "mt-event-hinweis-geschlossen"
      var id = balken.getAttribute("data-event-id")

      try {
        if (window.localStorage.getItem(SCHLUESSEL) === id) {
          balken.style.display = "none"
          return
        }
      } catch (e) {
        // localStorage gesperrt (privater Modus) — Balken bleibt sichtbar
      }

      var knopf = document.getElementById("event-hinweis-schliessen")
      if (knopf) {
        knopf.addEventListener("click", function () {
          balken.style.display = "none"
          try {
            window.localStorage.setItem(SCHLUESSEL, id)
          } catch (e) {
            // ohne Speicher erscheint der Hinweis beim nächsten Aufruf wieder
          }
        })
      }
    })()
  </script>
)}

<style>
  /* Auf schmalen Displays höchstens zwei Zeilen, damit der Balken nie
     zum Block wird. */
  .truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
